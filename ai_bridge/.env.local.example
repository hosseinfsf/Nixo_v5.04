# Rename this file to .env.local and fill the values locally.
# Do not share .env.local or put the API key inside the MQ5 source.
NIXO_AI_BASE_URL=https://api.openai.com/v1/chat/completions
NIXO_AI_MODEL=YOUR_MODEL_NAME
NIXO_AI_API_KEY=YOUR_API_KEY
NIXO_AI_REFRESH_SECONDS=30
NIXO_AI_TIMEOUT_SECONDS=25
# Optional if MT5 is installed in a non-default Windows profile:
# MT5_COMMON_FILES=C:\Users\YourUser\AppData\Roaming\MetaQuotes\Terminal\Common\Files
