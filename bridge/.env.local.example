# Copy this file to .env.local and fill in your own Telegram API credentials.
# Do NOT send your API hash, Telegram login code, password, or session file to anyone.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional: normally leave blank; the bridge auto-detects MT5 Common\\Files on Windows.
MT5_COMMON_FILES=
# X API v2 bearer token. Keep this secret local; never commit .env.local.
X_BEARER_TOKEN=
NIXO_X_POLL_SECONDS=60
# TradingView webhook: use a long random secret and expose only through HTTPS reverse proxy/tunnel.
NIXO_TV_WEBHOOK_SECRET=
NIXO_TV_WEBHOOK_HOST=127.0.0.1
NIXO_TV_WEBHOOK_PORT=8765
