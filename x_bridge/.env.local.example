# ==============================
# Nixo X Bridge - Environment
# ==============================

# X (Twitter) Bearer Token (الزامی)
X_BEARER_TOKEN=YOUR_X_BEARER_TOKEN_HERE

# Groq API Key (برای لایه AI - توصیه می‌شود)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# مسیر پوشه Common Files متاتریدر (اختیاری)
# اگر خالی باشد، اسکریپت سعی می‌کند خودش پیدا کند
# مثال:
# MT5_COMMON_FILES=C:\Users\YourName\AppData\Roaming\MetaQuotes\Terminal\Common\Files

MT5_COMMON_FILES=
